{
  "name": "muhzek-formul",
  "version": "0.1.0",
  "description": "eval'siz güvenli formül çözücü — recursive descent, beyaz listeli fonksiyonlar. Safe formula evaluator for user-supplied expressions (no eval, no Function).",
  "keywords": [
    "formula",
    "expression-parser",
    "safe-eval",
    "calculator",
    "recursive-descent",
    "engineering",
    "turkish"
  ],
  "license": "MIT",
  "author": "Mehmet UYANIK (https://muhzekai.com)",
  "homepage": "https://github.com/mehmetuyanik-rs/muhzek-formul#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetuyanik-rs/muhzek-formul.git"
  },
  "bugs": "https://github.com/mehmetuyanik-rs/muhzek-formul/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/hesap.cjs",
  "module": "./dist/hesap.js",
  "types": "./dist/hesap.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/hesap.d.ts",
        "default": "./dist/hesap.js"
      },
      "require": {
        "types": "./dist/hesap.d.cts",
        "default": "./dist/hesap.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/test.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
